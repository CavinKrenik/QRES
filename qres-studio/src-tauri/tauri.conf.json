{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qres-studio",
  "version": "10.1.0",
  "identifier": "com.cavin.qres-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "qres-studio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5RTlCRkY4NUZDN0ZEQjMKUldTei9jZGYrTC9wU1hHUXNJbXV0dmV3czNTdEl2WE1pQUFvekpyYzBFd1U1TjZ1aWxtTnVYQkwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}