Windows Registry Editor Version 5.00

; Add "Compress with QRES" to right-click context menu for all files
[HKEY_CLASSES_ROOT\*\shell\QRESCompress]
@="Compress with QRES"
"Icon"="C:\\Program Files\\QRES Studio\\qres-studio.exe"

[HKEY_CLASSES_ROOT\*\shell\QRESCompress\command]
@="\"C:\\Program Files\\QRES Studio\\qres-studio.exe\" \"%1\""

; Add "Decompress with QRES" for .qres files
[HKEY_CLASSES_ROOT\.qres]
@="QRES Archive"

[HKEY_CLASSES_ROOT\QRES Archive\shell\open]
@="Open with QRES Studio"

[HKEY_CLASSES_ROOT\QRES Archive\shell\open\command]
@="\"C:\\Program Files\\QRES Studio\\qres-studio.exe\" \"%1\""
